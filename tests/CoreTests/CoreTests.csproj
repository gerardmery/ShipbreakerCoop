<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests the engine-free core of the mod without the game. Run: dotnet run -c Release -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <PropertyGroup>
    <CoreDir Condition="'$(CoreDir)' == ''">..\..\mod\ShipbreakerCoop\Core</CoreDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(CoreDir)\*.cs" Link="Core\%(Filename).cs" />
  </ItemGroup>
</Project>
